# FluxGuard PMSM Environment Configuration Example

# Backend Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (dev uses H2 in-memory, prod uses PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fluxguard_db
DB_USER=fluxguard_user
DB_PASSWORD=fluxguard_secret

# Telemetry & Sampling Defaults
SIMULATION_SAMPLE_RATE_HZ=100
HARDWARE_SERIAL_PORT=COM3
HARDWARE_BAUD_RATE=115200

# Diagnostic Calibration Parameters
FLUX_REF_WB=0.085
TEMP_REF_C=20.0
ALPHA_PSI_PER_K=-0.0011
RESIDUAL_WARN_PERCENT=-3.5
RESIDUAL_FAULT_PERCENT=-5.0
PERSISTENCE_TIME_S=1.5

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=ws://localhost:8080/ws
